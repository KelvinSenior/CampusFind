generator client {
  provider = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  STUDENT
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum ReportType {
  LOST
  FOUND
}

enum ItemCategory {
  ELECTRONICS
  BAGS
  IDENTIFICATION
  BOOKS
  CLOTHING
  JEWELLERY
  KEYS
  DOCUMENTS
  OTHER
}

enum CampusLocation {
  LECTURE_HALL
  LIBRARY
  RESIDENCE
  CAFETERIA
  LABORATORY
  SPORTS_FACILITY
  ADMIN_BLOCK
  OTHER
}

enum ItemStatus {
  PENDING
  APPROVED
  REJECTED
  RECOVERED
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum AbuseStatus {
  OPEN
  RESOLVED
  REJECTED
}

model User {
  id                 String        @id @default(cuid())
  name               String
  email              String        @unique
  passwordHash       String
  role               UserRole      @default(STUDENT)
  status             UserStatus    @default(ACTIVE)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  reports            ItemReport[]
  claims             Claim[]
  notifications      Notification[]
  savedItems         SavedItem[]
  announcements      Announcement[]
  abuseReports       AbuseReport[]
  activityLogs       ActivityLog[]
}

model ItemReport {
  id                    String          @id @default(cuid())
  reference             String          @unique
  userId                String
  reportType            ReportType
  itemName              String
  category              ItemCategory
  description           String
  identifyingDetails    String?
  photoUrl              String?
  dateOccurred          DateTime
  location              CampusLocation
  locationDetails       String?
  status                ItemStatus      @default(PENDING)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  claims                Claim[]
  savedBy               SavedItem[]
  abuseReports          AbuseReport[]

  @@index([reportType, status, category])
  @@index([location, dateOccurred])
  @@index([userId, createdAt])
}

model Claim {
  id                   String       @id @default(cuid())
  reportId             String
  userId               String
  explanation          String
  distinguishingFeatures String
  additionalEvidence   String?
  status               ClaimStatus  @default(PENDING)
  handoverCode         String?      @unique
  handoverVerifiedAt   DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  report               ItemReport   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reportId, userId])
  @@index([status, createdAt])
}

model Notification {
  id         String   @id @default(cuid())
  userId     String
  title      String
  message    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

model SavedItem {
  id        String     @id @default(cuid())
  userId    String
  reportId  String
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  report    ItemReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([userId, reportId])
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  content     String
  category    String?
  publishedAt DateTime @default(now())
  isPublished Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User     @relation(fields: [createdById], references: [id])

  @@index([isPublished, publishedAt])
}

model AbuseReport {
  id          String      @id @default(cuid())
  reportId    String
  reporterId  String
  reason      String
  details     String?
  status      AbuseStatus @default(OPEN)
  createdAt   DateTime    @default(now())
  resolvedAt  DateTime?
  report      ItemReport  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reporter    User        @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model ActivityLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType, entityId])
}
