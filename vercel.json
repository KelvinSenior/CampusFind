{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --include=optional && npm ci --prefix backend --workspaces=false",
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist/frontend/browser",
  "functions": {
    "api/*.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/:path((?!api).*)",
      "destination": "/index.html"
    }
  ]
}
