{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "express",
      "entrypoint": "src/app.ts",
      "installCommand": "npm ci --workspaces=false",
      "buildCommand": "npm run db:generate && npm run build && npm prune --omit=dev --workspaces=false",
      "functions": {
        "src/app.ts": {
          "maxDuration": 30,
          "includeFiles": "node_modules/**"
        }
      }
    },
    "frontend": {
      "root": "frontend",
      "framework": "angular",
      "installCommand": "npm ci --workspaces=false --include=optional",
      "buildCommand": "npm run build",
      "outputDirectory": "dist/frontend/browser"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
