# Neon PostgreSQL: use pooled URL for runtime and direct URL for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require"

# Server-only authentication secret (generate with: openssl rand -base64 48)
JWT_SECRET="sksskssksskssksskssksskssksskssks"
NODE_ENV="development"
PORT=3000
CLIENT_ORIGIN="http://localhost:4200"

# Set only for the protected local administrator provisioning command.
ADMIN_EMAIL="admin@campusfind.edu"
ADMIN_PASSWORD="Masteraccount47@"
ADMIN_NAME="CampusFind Administrator"
CONFIRM_ADMIN_PROVISIONING="YES"

